{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anten-tv/anten-tv.github.io/data/schema/towers.schema.json",
  "title": "Anten VN towers dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "towers"],
  "properties": {
    "version": { "const": 1 },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "towers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tower" }
    }
  },
  "$defs": {
    "status": { "enum": ["active", "inactive", "unknown"] },
    "mux": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "operator", "status"],
      "properties": {
        "channel": { "type": "integer", "minimum": 21, "maximum": 48 },
        "operator": {
          "enum": ["SDTV", "VTV", "VTC", "DTV", "RTB", "AVG", "THVL", "unknown"]
        },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "tower": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "lat",
        "lon",
        "province",
        "addressOld",
        "muxes",
        "polarization",
        "heightM",
        "erpKw",
        "status",
        "source",
        "sourceUrl",
        "sourceDate",
        "verified",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "lat": { "type": "number", "minimum": 8.1, "maximum": 23.5 },
        "lon": { "type": "number", "minimum": 102.0, "maximum": 110.5 },
        "province": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "addressOld": { "type": ["string", "null"], "maxLength": 300 },
        "muxes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mux" }
        },
        "polarization": { "enum": ["H", "V", null] },
        "heightM": {
          "type": ["number", "null"],
          "minimum": 10,
          "maximum": 500
        },
        "erpKw": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "status": { "$ref": "#/$defs/status" },
        "source": { "type": "string", "minLength": 3, "maxLength": 200 },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "sourceDate": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "verified": { "type": "boolean" },
        "notes": { "type": ["string", "null"], "maxLength": 500 }
      }
    }
  }
}
